{
  "name": "zev-lock",
  "version": "0.1.0",
  "private": true,
  "description": "Zev Lock — mobile-first license platform (Next.js + Cloudflare Workers + D1)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "db:migrate:local": "wrangler d1 migrations apply zevlock-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply zevlock-db --remote",
    "db:seed:local": "wrangler d1 execute zevlock-db --local --file=./migrations/0002_seed.sql",
    "test:mobileconfig": "python3 scripts/test-mobileconfig.py",
    "test": "python3 scripts/test-mobileconfig.py"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "framer-motion": "^12.23.0",
    "lucide-react": "^0.469.0",
    "next": "^15.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260903.1",
    "@eslint/eslintrc": "^3.3.1",
    "@opennextjs/cloudflare": "^1.2.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.4.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
