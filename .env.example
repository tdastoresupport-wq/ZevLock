# ------------------------------------------------------------------
# Zev Lock — environment template (DEVELOPMENT ONLY values below)
# Copy to `.env.local` for Next.js dev, and use `wrangler secret put`
# for production. NEVER commit real secrets.
# ------------------------------------------------------------------

# HMAC secret used to sign license session tokens (min 32 chars in prod).
# Prod: `wrangler secret put SESSION_SECRET`
SESSION_SECRET=dev-only-session-secret-change-me-32-chars-min

# Admin API token (legacy/script access to /api/admin/* via `x-admin-token`).
# Prod: `wrangler secret put ADMIN_API_TOKEN`
ADMIN_API_TOKEN=dev-only-admin-token-change-me

# Admin password login (first run only): when no admin exists yet, signing in
# with these credentials provisions a SUPER_ADMIN (bcrypt-hashed) automatically.
# NEVER commit real values. Prod: `wrangler secret put ADMIN_EMAIL` (+ ADMIN_PASSWORD).
# Rotate immediately if these values were ever shared or pasted anywhere.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# Default license settings for newly generated keys (admin can override).
DEFAULT_DEVICE_LIMIT=1
DEFAULT_PLAN=Premium

# Demo license for local development (matches migrations/0002_seed.sql).
DEMO_LICENSE_KEY=ZEV-DEMO-2026-VIP1
